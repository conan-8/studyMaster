# Supabase (Postgres) — copy the URI from Supabase Dashboard → Project → Connect
# (Session pooler / Direct connection is fine for local scripts; port 5432).
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# App runtime (later phases): Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Question generator (npm run generate)
GENERATOR_PROVIDER=openrouter        # or mock (keyless dry-runs) or kimi
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=minimax/minimax-m3  # optional override

# Kimi Code plan (alternative to openrouter; set GENERATOR_PROVIDER=kimi)
KIMI_API_KEY=sk-kimi-...
KIMI_MODEL=k3                        # optional override

# Looseleaf coach chat (/api/chat — local serve.ts and Vercel function)
# Use a pay-as-you-go Model Studio key (sk-...), not a Coding Plan key (sk-sp-...).
# Workspace-scoped base URL: https://<WorkspaceId>.<region>.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=sk-...
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # optional override
ALIBABA_MODEL=deepseek-v4-flash-0731                                       # optional override
