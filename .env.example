# Supabase (Postgres) — copy the URI from Supabase Dashboard → Project → Connect
# (Session pooler / Direct connection is fine for local scripts; port 5432).
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# App runtime (later phases): Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Question generator (npm run generate)
GENERATOR_PROVIDER=openrouter        # or mock (keyless dry-runs)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=minimax/minimax-m3  # optional override
