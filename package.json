{
  "name": "studymaste",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "studyMaste data layer: contracts validation, Supabase (Postgres) schema, and seed tooling",
  "scripts": {
    "validate:exam-formats": "tsx scripts/validate-exam-formats.ts",
    "validate:taxonomy": "tsx scripts/validate-taxonomy.ts",
    "validate:misconceptions": "tsx scripts/validate-misconceptions.ts",
    "validate:diagrams": "tsx scripts/validate-diagrams.ts",
    "validate:archetypes": "tsx scripts/validate-archetypes.ts",
    "validate:questions": "tsx scripts/validate-questions.ts",
    "validate:sat-bank": "tsx scripts/validate-sat-bank.ts --fixtures",
    "validate:all": "npm run validate:exam-formats && npm run validate:taxonomy && npm run validate:misconceptions && npm run validate:diagrams && npm run validate:archetypes && npm run validate:questions && npm run validate:sat-bank",
    "test": "tsx --test src/llm/*.test.ts src/generator/*.test.ts src/generator/eval/*.test.ts src/renderers/tests/*.test.ts",
    "eval:generator": "tsx src/generator/eval/run.ts",
    "generate": "tsx --env-file-if-exists=.env scripts/generate-question.ts",
    "gallery": "tsx scripts/render-gallery.ts",
    "gallery:questions": "tsx scripts/question-gallery.ts",
    "build:sim": "esbuild simulator/browser-entry.ts --bundle --format=iife --global-name=StudyMasteRenderers --outfile=simulator/renderers.js --alias:node:fs=./simulator/shims/fs.ts --alias:node:path=./simulator/shims/path.ts --alias:node:url=./simulator/shims/url.ts",
    "db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
