{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cramduck.dev/schemas/taxonomy.schema.json",
  "title": "Subject Taxonomy",
  "description": "Validates a subject taxonomy file (database/<SUBJECT>/taxonomy.json): the canonical hierarchy of domains, skills, and (for AP) units, topics, and learning objectives. Node codes are subject-scoped, e.g. 'SAT_RW:boundaries'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "nodes"],
  "properties": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(AP|SAT)_[A-Z0-9_]+$",
          "description": "Subject code, e.g. 'SAT_RW', 'SAT_MATH', 'AP_CALC_AB'"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name, e.g. 'SAT Reading and Writing'"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "kind",
          "title",
          "slug",
          "description",
          "parentCode",
          "examWeightPercent",
          "sortOrder"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]+[A-Z0-9_]*:[a-z0-9-]+$",
            "description": "Subject-scoped node code, e.g. 'SAT_RW:expression-of-ideas' or 'SAT_RW:transitions'"
          },
          "kind": {
            "type": "string",
            "enum": ["domain", "skill", "unit", "topic", "learning_objective", "skill_code"],
            "description": "SAT uses domain/skill; AP subjects additionally use unit/topic/learning_objective/skill_code"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display name, e.g. 'Expression of Ideas' or 'Transitions'"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Kebab-case slug. For skill nodes this MUST equal the skill slug used in question.schema.json's skill enum (e.g. 'transitions', 'linear-functions')"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "1-3 sentences describing what this node covers"
          },
          "parentCode": {
            "type": ["string", "null"],
            "pattern": "^[A-Z]+[A-Z0-9_]*:[a-z0-9-]+$",
            "description": "Code of the parent node; null only for domain/unit roots"
          },
          "examWeightPercent": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100,
            "description": "Share of the exam this node carries; only domain/unit roots carry weights, all other nodes use null"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based display order within the taxonomy"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "enum": ["domain", "unit"] } },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "parentCode": { "type": "null" }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": { "enum": ["skill", "topic", "learning_objective", "skill_code"] }
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "parentCode": { "type": "string" },
                "examWeightPercent": { "type": "null" }
              }
            }
          }
        ]
      }
    }
  }
}
